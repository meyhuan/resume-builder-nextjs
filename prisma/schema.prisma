datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id         String     @id @default(cuid())
  clerkId    String?    @unique
  wxId       String?    @unique  // Java tb_cvuser.id (auth_uid cookie value)
  javaUserId String?    @unique  // Java tb_user.id (VIP / payment system)
  email      String?    @unique
  name       String?
  avatar     String?
  resumes    Resume[]
  jobFitTasks JobFitTask[]
  exports    ExportRecord[]
  feedbacks  Feedback[]
  quotas     UserQuota[]
  migration  ResumeMigration?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Resume {
  id        String   @id @default(cuid())
  title     String
  content   Json
  template  String   @default("simple")
  thumbnail String?
  meta      Json?    // { javaId?: string, migratedAt?: ISO string, ... }
  kind      ResumeKind @default(BASE)
  sourceResumeId String?
  sourceResume Resume? @relation("ResumeJobFitSource", fields: [sourceResumeId], references: [id], onDelete: SetNull)
  tailoredResumes Resume[] @relation("ResumeJobFitSource")
  jobFitSourceTasks JobFitTask[] @relation("JobFitSourceResume")
  jobFitTailoredTask JobFitTask? @relation("JobFitTailoredResume")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, kind, updatedAt])
  @@index([sourceResumeId])
}

enum ResumeKind {
  BASE
  JOB_FIT
}

enum JobFitSourceType {
  EXISTING
  FILE
  TEXT
}

enum JobFitStatus {
  DRAFT
  PARSING_SOURCE
  READY
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum JobFitStage {
  PREPARE
  ANALYZE
  OPTIMIZE
  EXPLAIN
}

enum JobFitQuotaState {
  NONE
  RESERVED
  COMMITTED
  RELEASED
}

enum JobFitOptimizationMode {
  PROFESSIONAL
  SPRINT
}

model JobFitTask {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType           JobFitSourceType
  sourceResumeId       String?
  sourceResume         Resume?          @relation("JobFitSourceResume", fields: [sourceResumeId], references: [id], onDelete: SetNull)
  tailoredResumeId     String?          @unique
  tailoredResume       Resume?          @relation("JobFitTailoredResume", fields: [tailoredResumeId], references: [id], onDelete: SetNull)
  idempotencyKey       String
  retryOfTaskId        String?
  retryOfTask          JobFitTask?       @relation("JobFitRetries", fields: [retryOfTaskId], references: [id], onDelete: SetNull)
  retries              JobFitTask[]      @relation("JobFitRetries")
  billingRootTaskId    String?
  companyName          String?
  jobTitle             String?
  jobDescription       String?
  jobUrl               String?
  focusAreas           Json             @default("[]")
  optimizationMode     JobFitOptimizationMode @default(PROFESSIONAL)
  sourceSnapshot       Json?
  sourceHash           String?
  optimizedSnapshot    Json?
  scoring              Json?
  summary              Json?
  changes              Json?
  claims               Json?
  readiness            String?
  resultSchemaVersion  String?
  engineVersion        String?
  status               JobFitStatus     @default(DRAFT)
  stage                JobFitStage      @default(PREPARE)
  progress             Int              @default(0)
  errorCode            String?
  errorMessage         String?
  retryable            Boolean          @default(false)
  quotaState           JobFitQuotaState @default(NONE)
  quotaDate            String?
  leaseToken           String?
  leaseExpiresAt       DateTime?
  cancelRequestedAt    DateTime?
  promptVersion        String           @default("job-fit-prompt-v1")
  scoringVersion       String           @default("job-fit-score-v1")
  modelName            String?
  factGuardRejectCount Int              @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status, leaseExpiresAt])
  @@index([sourceResumeId])
  @@index([billingRootTaskId])
}

model ExportRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wxId        String
  resumeId    String
  resumeTitle String
  templateId  String?
  type        String
  fileName    String
  token       String   @unique
  ossKey      String?
  ossUrl      String?
  expiresAt   DateTime
  status      String   @default("available")
  confirmedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([wxId, createdAt])
  @@index([userId, createdAt])
}

/// One row per user tracking the mini-program -> Next.js resume migration.
/// status: 'pending' | 'running' | 'done' | 'failed' | 'no_source'
model ResumeMigration {
  userId        String    @id
  sourceCount   Int       @default(0)
  migratedCount Int       @default(0)
  status        String
  failedItems   Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id          String   @id @default(cuid())
  content     String   // The feedback text content
  contact     String?  // Optional contact info (email/phone/wechat)
  attachment  String?  // Optional base64 or URL for uploaded image/screenshot
  diagnostics Json?
  requestLogs Json?
  status      String   @default("RECEIVED")
  adminReply  String?
  adminReplyAt DateTime?
  likeCount   Int      @default(0)
  userId      String?  // Optional relation if user is logged in
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model UserQuota {
  userId    String   @id  // References User.id, one row per user
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotas    Json     @default("{}") // { "ai:generate-resume": { used: 5, date: "2025-01-15" }, ... }
  updatedAt DateTime @updatedAt
}
