datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id         String     @id @default(cuid())
  clerkId    String?    @unique
  wxId       String?    @unique  // Java tb_cvuser.id (auth_uid cookie value)
  javaUserId String?    @unique  // Java tb_user.id (VIP / payment system)
  email      String?    @unique
  name       String?
  avatar     String?
  resumes    Resume[]
  exports    ExportRecord[]
  feedbacks  Feedback[]
  quotas     UserQuota[]
  migration  ResumeMigration?
  applicationProfile       ApplicationProfile?
  jobApplications          JobApplication[]
  extensionAuthorizations  ExtensionAuthorization[]
  extensionAuthCodes       ExtensionAuthCode[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Resume {
  id        String   @id @default(cuid())
  title     String
  content   Json
  template  String   @default("simple")
  thumbnail String?
  meta      Json?    // { javaId?: string, migratedAt?: ISO string, ... }
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  applicationProfiles ApplicationProfile[]
  jobApplications     JobApplication[]

  @@index([userId])
}

model ApplicationProfile {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultResumeId  String?
  defaultResume    Resume?  @relation(fields: [defaultResumeId], references: [id], onDelete: SetNull)
  encryptedPayload String
  schemaVersion    Int      @default(1)
  lastResumeSyncAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([defaultResumeId])
}

enum JobApplicationStatus {
  DRAFT
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model JobApplication {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId       String?
  resume         Resume?              @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  companyName    String
  jobTitle       String
  location       String?
  jobUrl         String?
  applicationUrl String?
  sourceDomain   String?
  status         JobApplicationStatus @default(DRAFT)
  appliedAt      DateTime?
  deadlineAt     DateTime?
  nextActionAt   DateTime?
  nextActionType String?
  note           String?
  fingerprint    String
  events         JobApplicationEvent[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId, status, updatedAt])
  @@index([userId, nextActionAt])
  @@index([resumeId])
}

model JobApplicationEvent {
  id            String                @id @default(cuid())
  applicationId String
  application   JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    JobApplicationStatus?
  toStatus      JobApplicationStatus?
  note          String?
  createdAt     DateTime              @default(now())

  @@index([applicationId, createdAt])
}

model ExtensionAuthCode {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String   @unique
  codeChallenge String
  redirectUri   String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([userId, expiresAt])
}

model ExtensionAuthorization {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  deviceName String?
  scopes     String[]
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, expiresAt])
}

model ExportRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wxId        String
  resumeId    String
  resumeTitle String
  templateId  String?
  type        String
  fileName    String
  token       String   @unique
  ossKey      String?
  ossUrl      String?
  expiresAt   DateTime
  status      String   @default("available")
  confirmedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([wxId, createdAt])
  @@index([userId, createdAt])
}

/// One row per user tracking the mini-program -> Next.js resume migration.
/// status: 'pending' | 'running' | 'done' | 'failed' | 'no_source'
model ResumeMigration {
  userId        String    @id
  sourceCount   Int       @default(0)
  migratedCount Int       @default(0)
  status        String
  failedItems   Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id          String   @id @default(cuid())
  content     String   // The feedback text content
  contact     String?  // Optional contact info (email/phone/wechat)
  attachment  String?  // Optional base64 or URL for uploaded image/screenshot
  diagnostics Json?
  requestLogs Json?
  status      String   @default("RECEIVED")
  adminReply  String?
  adminReplyAt DateTime?
  likeCount   Int      @default(0)
  userId      String?  // Optional relation if user is logged in
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model UserQuota {
  userId    String   @id  // References User.id, one row per user
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotas    Json     @default("{}") // { "ai:generate-resume": { used: 5, date: "2025-01-15" }, ... }
  updatedAt DateTime @updatedAt
}
